<?xml version="1.0" encoding="utf-8"?>
<!-- Vs Bot tile: dark base with cyan left-edge gradient + subtle border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark fill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#0C121C" />
        </shape>
    </item>
    <!-- Cyan gradient overlay from left -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="0"
                android:startColor="#2200F5FF"
                android:centerColor="#0800F5FF"
                android:endColor="#0000F5FF"
                android:type="linear" />
        </shape>
    </item>
    <!-- Cyan border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#3300F5FF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
