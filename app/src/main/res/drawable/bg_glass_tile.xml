<?xml version="1.0" encoding="utf-8"?>
<!-- Cyber game tile: 8dp corners, dark fill, neon-cyan border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark fill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <gradient
                android:angle="135"
                android:startColor="#920A1424"
                android:endColor="#72040A18"
                android:type="linear" />
        </shape>
    </item>
    <!-- Neon cyan border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#3800F5FF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- Top-edge shimmer -->
    <item android:gravity="top" android:height="8dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="8dp"
                android:topRightRadius="8dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="#14FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
