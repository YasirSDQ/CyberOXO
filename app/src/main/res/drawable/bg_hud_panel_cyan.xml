<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Box: Very dark cyan tint, 1dp subtle border, sharp corners -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="0dp" />
            <gradient
                android:angle="135"
                android:startColor="#1A00F5FF"
                android:centerColor="#0500F5FF"
                android:endColor="#02000A10"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#2500F5FF" />
        </shape>
    </item>
</layer-list>
