<?xml version="1.0" encoding="utf-8"?>
<!-- Floating VS divider badge: dark circle with outline border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark fill -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#141E2C" />
        </shape>
    </item>
    <!-- Outer glow ring (slightly larger, semi-transparent) -->
    <item android:top="-2dp" android:bottom="-2dp" android:left="-2dp" android:right="-2dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#2200F5FF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- Inner border -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#445A6A" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
