<?xml version="1.0" encoding="utf-8"?>
<!-- Active X player card: neon pink border + gradient fill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="135"
                android:startColor="#40FF2D55"
                android:endColor="#1AFF2D55"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#CCFF2D55" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
