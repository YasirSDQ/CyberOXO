<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Box: Very dark pink tint, 1dp subtle border, sharp corners -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="0dp" />
            <gradient
                android:angle="135"
                android:startColor="#1AFF2D55"
                android:centerColor="#05FF2D55"
                android:endColor="#020A0005"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#25FF2D55" />
        </shape>
    </item>
</layer-list>
