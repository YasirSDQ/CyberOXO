<?xml version="1.0" encoding="utf-8"?>
<!-- Cyber panel: 12dp corners, dark tinted fill, neon-cyan border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark gradient fill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="135"
                android:startColor="#88040B1C"
                android:endColor="#60020610"
                android:type="linear" />
        </shape>
    </item>
    <!-- Neon cyan border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#3000F5FF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- Top-edge inner shimmer -->
    <item android:gravity="top" android:height="12dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="12dp"
                android:topRightRadius="12dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="#0DFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
