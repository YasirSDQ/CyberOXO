<?xml version="1.0" encoding="utf-8"?>
<!-- Vs Friend tile: dark base with pink left-edge gradient + subtle border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark fill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#0C121C" />
        </shape>
    </item>
    <!-- Pink gradient overlay from left -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="0"
                android:startColor="#22FF2D55"
                android:centerColor="#08FF2D55"
                android:endColor="#00FF2D55"
                android:type="linear" />
        </shape>
    </item>
    <!-- Pink border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#33FF2D55" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
