<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass"
    android:padding="28dp">

    <!-- Winner emoji / mark -->
    <TextView
        android:id="@+id/tvResultMark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="X"
        android:textSize="72sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:textColor="@color/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/tvResultTitle" />

    <!-- Win / Draw title -->
    <TextView
        android:id="@+id/tvResultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="X WINS!"
        android:textColor="@color/colorOnSurface"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:fontFamily="monospace"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvResultMark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/tvResultSubtitle" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvResultSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ENGAGEMENT COMPLETE"
        android:textColor="@color/colorCyberGreen"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvResultTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toTopOf="@id/btnPlayAgain" />

    <!-- Play Again -->
    <Button
        android:id="@+id/btnPlayAgain"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/play_again"
        android:textColor="@color/colorSecondary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:background="@drawable/bg_start_button_bot"
        android:stateListAnimator="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvResultSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnExitGame" />

    <!-- Exit Game -->
    <Button
        android:id="@+id/btnExitGame"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/exit_game"
        android:textColor="@color/colorError"
        android:textSize="15sp"
        android:fontFamily="monospace"
        android:background="@drawable/bg_pill_button_danger"
        android:stateListAnimator="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnPlayAgain"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
