<?xml version="1.0" encoding="utf-8"?>
<!-- Difficulty Selector Bottom Sheet -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvDifficultyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ SELECT DIFFICULTY"
        android:textColor="@color/colorOnSurface"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:layout_gravity="center_horizontal"/>

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/colorOutlineVariant"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"/>

    <!-- Easy Option -->
    <TextView
        android:id="@+id/diff_easy"
        android:tag="diff_easy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢"
                android:textSize="20sp"
                android:layout_marginEnd="12dp"/>
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Easy"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Random moves - Perfect for beginners"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </LinearLayout>
    </TextView>

    <!-- Medium Option -->
    <TextView
        android:id="@+id/diff_medium"
        android:tag="diff_medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟡"
                android:textSize="20sp"
                android:layout_marginEnd="12dp"/>
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medium"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart moves - A balanced challenge"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </LinearLayout>
    </TextView>

    <!-- Impossible Option -->
    <TextView
        android:id="@+id/diff_impossible"
        android:tag="diff_impossible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴"
                android:textSize="20sp"
                android:layout_marginEnd="12dp"/>
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Impossible"
                    android:textColor="@color/colorError"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unbeatable AI - Master level"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </LinearLayout>
    </TextView>

</LinearLayout>
