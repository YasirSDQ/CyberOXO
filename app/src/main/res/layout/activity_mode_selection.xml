<?xml version="1.0" encoding="utf-8"?>
<!--
    MODE SELECTION DASHBOARD – "Cyber Nexus" Layout
    ════════════════════════════════════════════════
    
    Features:
    • Holographic game mode cards
    • Theme selector chip
    • Board size selector chip  
    • Difficulty indicator chip
    • Player stats display
    • Animated background gradients
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- ── Ambient cyan glow (top-left) ── -->
    <View
        android:id="@+id/glowCyan"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="@drawable/bg_app_gradient"
        android:alpha="0.22"
        android:layout_marginTop="-80dp"
        android:layout_marginStart="-80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ── Ambient pink glow (bottom-right) ── -->
    <View
        android:id="@+id/glowPink"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/bg_cyber_card_pink"
        android:alpha="0.12"
        android:layout_marginBottom="-60dp"
        android:layout_marginEnd="-60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════
         HEADER  –  Logo + label
    ══════════════════════════════════════ -->

    <ImageView
        android:id="@+id/ivLogoLarge"
        android:layout_width="190dp"
        android:layout_height="52dp"
        android:src="@drawable/header_logo"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:contentDescription="@string/cd_logo"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tiny "SELECT MODE" eyebrow label -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="— SELECT MODE —"
        android:textColor="@color/colorOnSurfaceVariant"
        android:textSize="10sp"
        android:letterSpacing="0.3"
        android:fontFamily="monospace"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/ivLogoLarge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════
         SETTINGS CHIPS ROW
    ══════════════════════════════════════ -->
    <HorizontalScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            
            <!-- Theme Selector Chip -->
            <androidx.cardview.widget.CardView
                android:id="@+id/chipTheme"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#1A1E2D40"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎨"
                        android:textSize="14sp"
                        android:layout_marginEnd="6dp"/>
                    
                    <TextView
                        android:id="@+id/tvSelectedTheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Neon"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            
            <!-- Board Size Chip -->
            <androidx.cardview.widget.CardView
                android:id="@+id/chipBoardSize"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#1A1E2D40"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📐"
                        android:textSize="14sp"
                        android:layout_marginEnd="6dp"/>
                    
                    <TextView
                        android:id="@+id/tvSelectedBoardSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3x3"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            
            <!-- Difficulty Chip -->
            <androidx.cardview.widget.CardView
                android:id="@+id/chipDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                app:cardBackgroundColor="#1A1E2D40"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="14sp"
                        android:layout_marginEnd="6dp"/>
                    
                    <TextView
                        android:id="@+id/tvSelectedDifficulty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medium"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Horizontal mid-guideline (separates the two tile zones) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineMid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.525" />

    <!-- ══════════════════════════════════════
         BOT MODE TILE  (upper half)
         Full-width panel · cyan accent
    ══════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardVsBot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_mode_tile_bot"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="7dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toTopOf="@id/guidelineMid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ── Left cyan accent bar ── -->
        <View
            android:id="@+id/accentBot"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="@color/colorSecondary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- ── Mode number (top-right) ── -->
        <TextView
            android:id="@+id/tvBotNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01"
            android:textColor="@color/colorSecondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:fontFamily="monospace"
            android:alpha="0.55"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="18dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Large emoji icon (left zone) ── -->
        <TextView
            android:id="@+id/iconBot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖"
            android:textSize="54sp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/btnStartBot"
            app:layout_constraintStart_toEndOf="@id/accentBot"
            app:layout_constraintVertical_bias="0.38" />

        <!-- ── Mode title ── -->
        <TextView
            android:id="@+id/tvBotTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="VS BOT"
            android:textColor="@color/colorSecondary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:fontFamily="monospace"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            app:layout_constraintTop_toTopOf="@id/iconBot"
            app:layout_constraintStart_toEndOf="@id/iconBot"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Thin cyan underline accent under title ── -->
        <View
            android:id="@+id/titleUnderlineBot"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:background="@color/colorSecondary"
            android:alpha="0.35"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="60dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvBotTitle"
            app:layout_constraintStart_toEndOf="@id/iconBot"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Description ── -->
        <TextView
            android:id="@+id/tvBotDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Challenge the AI. Adaptive difficulty\nscales with your skill in real time."
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:lineSpacingMultiplier="1.45"
            android:fontFamily="monospace"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/titleUnderlineBot"
            app:layout_constraintStart_toEndOf="@id/iconBot"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── ENGAGE button ── -->
        <Button
            android:id="@+id/btnStartBot"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:text="ENGAGE  ›"
            android:textColor="@color/colorSecondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0.12"
            android:fontFamily="monospace"
            android:background="@drawable/bg_start_button_bot"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══════════════════════════════════════
         FRIEND MODE TILE  (lower half)
         Full-width panel · pink accent
    ══════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardVsFriend"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_mode_tile_friend"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="28dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/guidelineMid"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ── Left pink accent bar ── -->
        <View
            android:id="@+id/accentFriend"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="@color/colorPrimary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- ── Mode number (top-right) ── -->
        <TextView
            android:id="@+id/tvFriendNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02"
            android:textColor="@color/colorPrimary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:fontFamily="monospace"
            android:alpha="0.55"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="18dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Large emoji icon (left zone) ── -->
        <TextView
            android:id="@+id/iconFriend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👥"
            android:textSize="54sp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/btnStartFriend"
            app:layout_constraintStart_toEndOf="@id/accentFriend"
            app:layout_constraintVertical_bias="0.38" />

        <!-- ── Mode title ── -->
        <TextView
            android:id="@+id/tvFriendTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="VS FRIEND"
            android:textColor="@color/colorPrimary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:fontFamily="monospace"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            app:layout_constraintTop_toTopOf="@id/iconFriend"
            app:layout_constraintStart_toEndOf="@id/iconFriend"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Thin pink underline accent under title ── -->
        <View
            android:id="@+id/titleUnderlineFriend"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:background="@color/colorPrimary"
            android:alpha="0.35"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="60dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvFriendTitle"
            app:layout_constraintStart_toEndOf="@id/iconFriend"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Description ── -->
        <TextView
            android:id="@+id/tvFriendDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Local multiplayer. Pass and play\non the same device with a friend."
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:lineSpacingMultiplier="1.45"
            android:fontFamily="monospace"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/titleUnderlineFriend"
            app:layout_constraintStart_toEndOf="@id/iconFriend"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── ENGAGE button ── -->
        <Button
            android:id="@+id/btnStartFriend"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:text="ENGAGE  ›"
            android:textColor="@color/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0.12"
            android:fontFamily="monospace"
            android:background="@drawable/bg_start_button_friend"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══════════════════════════════════════
         Floating VS badge (centred on the gap)
    ══════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvVsDivider"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:text="VS"
        android:textColor="@color/colorOnSurface"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:fontFamily="monospace"
        android:gravity="center"
        android:background="@drawable/bg_vs_badge"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="@id/guidelineMid"
        app:layout_constraintBottom_toBottomOf="@id/guidelineMid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════
         PLAYER STATS PANEL (bottom overlay)
    ══════════════════════════════════════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#1A1E2D40"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp">
            
            <!-- Games Played -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                
                <TextView
                    android:id="@+id/tvStatsGames"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GAMES"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"/>
            </LinearLayout>
            
            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="@color/colorOutlineVariant"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
            
            <!-- Wins -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                
                <TextView
                    android:id="@+id/tvStatsWins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="28"
                    android:textColor="@color/colorSecondary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WINS"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"/>
            </LinearLayout>
            
            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="@color/colorOutlineVariant"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
            
            <!-- Win Rate -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                
                <TextView
                    android:id="@+id/tvStatsWinRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="67%"
                    android:textColor="@color/colorPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RATE"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
